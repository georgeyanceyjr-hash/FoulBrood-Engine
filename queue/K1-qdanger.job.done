# Nonlinear queen danger (chess-style king danger), both queens: qd20 / qd40 vs current v2.4 (h2h/pb). Also vs Foulbrood 5.3.
export PATH="$HOME/.cargo/bin:$PATH"
python3 -c "open('src/eval.rs','w').write(open('eval_qd.rs').read())"
grep -q qdanger src/eval.rs || { echo "eval.rs not updated"; exit 1; }
cargo build --release > results/build-qd.log 2>&1 || { echo BUILD FAILED; exit 1; }
cp tools/net14.txt target/release/thoraxrex-net.txt
export VARIANTS="qd20 qd40" OPPS="../../ThoraxRex/h2h/pb/thoraxrex" SHARDS=5 GAMES=24 SO=32000 MATCH_RANDPLIES=2
./tools/par.command
export VARIANTS="qd20 qd40" OPPS="Foulbrood-4.1/wrapper.py Foulbrood-5.3/wrapper.py" SHARDS=2 GAMES=12 SO=33000 MATCH_RANDPLIES=2
./tools/par.command
rm -f target/release/thoraxrex-net.txt
exit 0
