# v214 = v213 with a faster net evaluation (the first layer skips zero inputs; identical scores on 130 test positions,
# about 6-8 % more positions searched per second on the test machine). Builds it, then a no-regression check:
# v214 against v213, same net (q12), 100 games at 1 s, no books, random first move and reply.
export PATH="$HOME/.cargo/bin:$PATH"
[ -x h2h/v213/thoraxrex ] || exit 1
cargo build --release > results/build-zx.log 2>&1 || { echo BUILD FAILED; exit 1; }
mkdir -p h2h/v214 results/err
cp target/release/thoraxrex h2h/v214/thoraxrex; cp h2h/v213/thoraxrex-net.txt h2h/v214/thoraxrex-net.txt
TAG=$(date +%m%d-%H%M)
unset TR_POLICY TR_CLIMB TR_NET
export TR_BOOK=none
PIDS=()
for s in 1 2 3 4; do
  ( MATCH_RANDPLIES=2 MATCH_ERRDIR=results/err MATCH_THREADS=1 MATCH_OPPENV="TR_BOOK=none" MATCH_GAMES=results/games-v214-v213-$TAG-$s.txt \
    python3 -u tools/match.py h2h/v214/thoraxrex "$PWD/h2h/v213/thoraxrex" 25 1 Base+MLP $((s*101+190000)) > results/par-v214-v213-$TAG-$s.log 2>&1 ) &
  PIDS+=($!)
done
wait $PIDS
python3 tools/sumpar.py results "$TAG" | tee results/summary-$TAG.txt
exit 0
