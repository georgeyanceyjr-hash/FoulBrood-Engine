# Pillbug guard about to be covered by an enemy beetle/mosquito (hand weight 5: 50 -> 120/200), alone and with beetle-pinning gb250. vs v2.8 and 4.1.
# + climb: search treats beetle/mosquito climbs next to a queen and pillbug throws as tactical (no pruning, less reduction).
export PATH="$HOME/.cargo/bin:$PATH"
python3 -c "open('src/eval.rs','w').write(open('eval_q5.rs').read()); open('src/search.rs','w').write(open('search_q5.rs').read())"
grep -q TR_EARLY src/eval.rs || { echo "eval.rs not updated"; exit 1; }
cargo build --release > results/build-s1.log 2>&1 || { echo BUILD FAILED; exit 1; }
cp tools/net14.txt target/release/thoraxrex-net.txt
export VARIANTS="pb120 gbpb120 gbpb200 climb" OPPS="../../ThoraxRex/h2h/v28/thoraxrex" SHARDS=4 GAMES=30 SO=64000 MATCH_RANDPLIES=2
./tools/par.command
export VARIANTS="pb120 gbpb120 gbpb200 climb" OPPS="Foulbrood-4.1/wrapper.py" SHARDS=3 GAMES=12 SO=65000 MATCH_RANDPLIES=2
./tools/par.command
rm -f target/release/thoraxrex-net.txt
exit 0
