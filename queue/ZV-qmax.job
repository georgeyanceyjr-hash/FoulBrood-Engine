# Deeper queen-attack search (TR_QMAX): in the losses to Formi and Antsy the engine rated itself well ahead until a
# few moves before it was mated. With TR_QMAX=4 it chose a different move at the key point of the Antsy game.
# By default the queen-pressure quiescence search is switched off (TR_QMAX=0). This plays v213 with it on (2 and 4)
# against v213 as installed: 100 games each at 1 s, no books, random first move and reply.
[ -x h2h/v213/thoraxrex ] || exit 1
mkdir -p results/err
TAG=$(date +%m%d-%H%M)
unset TR_NET TR_POLICY TR_CLIMB
export TR_BOOK=none
PIDS=()
for q in 2 4; do
  for s in 1 2; do
    ( TR_QMAX=$q MATCH_RANDPLIES=2 MATCH_ERRDIR=results/err MATCH_THREADS=1 MATCH_OPPENV="TR_BOOK=none" MATCH_GAMES=results/games-qmax$q-v213-$TAG-$s.txt \
      python3 -u tools/match.py h2h/v213/thoraxrex "$PWD/h2h/v213/thoraxrex" 50 1 Base+MLP $((s*101+q*1000+170000)) > results/par-qmax$q-v213-$TAG-$s.log 2>&1 ) &
    PIDS+=($!)
  done
done
wait $PIDS
python3 tools/sumpar.py results "$TAG" | tee results/summary-$TAG.txt
exit 0
