# Move-policy transformer v1: dump Formi/Antsy/SixfoldOptera moves from the archive (encoder in src/policy.rs),
# train with PyTorch (MPS), and check the Rust forward pass matches the trainer.
export PATH="$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
python3 -c "
for n in ['policy','main','datagen']: open(f'src/{n}.rs','w').write(open(f'src_{n}.rs').read())"
cargo build --release > results/build-s2.log 2>&1 || { echo BUILD FAILED; exit 1; }
PY=""
for p in python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3 $HOME/miniconda3/bin/python3 $HOME/anaconda3/bin/python3 /Library/Frameworks/Python.framework/Versions/Current/bin/python3; do
  if command -v $p >/dev/null 2>&1 && $p -c "import torch" 2>/dev/null; then PY=$p; break; fi
done
echo "python with torch: $PY" > results/policy-v1.log
[ -z "$PY" ] && { echo "no torch found" >> results/policy-v1.log; exit 0; }
$PY -c "import torch;print(torch.__version__, 'mps', torch.backends.mps.is_available())" >> results/policy-v1.log 2>&1
mkdir -p data
./target/release/thoraxrex policydump tools/bots_arch.jsonl data/pol_dump.txt 120 Formi,Antsy,SixfoldOptera >> results/policy-v1.log 2>&1
wc -l data/pol_dump.txt >> results/policy-v1.log
# quick sanity run + Rust/trainer agreement check
head -3000 data/pol_dump.txt > data/pol_small.txt
$PY -u tools/policy_train.py data/pol_small.txt data/pol_small_w.txt 1 32 1 4 64 >> results/policy-v1.log 2>&1
./target/release/thoraxrex policycheck data/pol_small_w.txt data/pol_small.txt 1 >> results/policy-v1.log 2>&1
# full run
$PY -u tools/policy_train.py data/pol_dump.txt tools/policy_v1.txt 12 64 3 4 128 >> results/policy-v1.log 2>&1
./target/release/thoraxrex policycheck tools/policy_v1.txt data/pol_dump.txt 1 >> results/policy-v1.log 2>&1
exit 0
