# Pillbug-guard terms: penalise our pillbug / pillbug-copying mosquito next to our queen being coverable (50) or covered (120).
# A = new eval ; B = h2h/b24 (v2.4 without these terms).
export PATH="$HOME/.cargo/bin:$PATH"
python3 -c "open('src/eval.rs','w').write(open('eval_pb.rs').read())"
grep -q "pbcovered" src/eval.rs || { echo "eval.rs not updated"; exit 1; }
cargo build --release > results/build-pb.log 2>&1 || { echo BUILD FAILED; exit 1; }
cp tools/net14.txt target/release/thoraxrex-net.txt
export VARIANTS="pb" OPPS="../../ThoraxRex/h2h/b24/thoraxrex" SHARDS=10 GAMES=12 SO=27000 MATCH_RANDPLIES=2
./tools/par.command
rm -f target/release/thoraxrex-net.txt
exit 0
