# q16: a bigger net. Every net so far has two hidden layers of 64 and 32 units. This trains 96 and 48 on the same
# data as q15 (sp2..sp12, with the depth-6 games if they exist), same recipe otherwise. A bigger net judges positions
# better but is slower to run, so the match is what counts: q16 against the installed net q12, same build (v214),
# 200 games at 1 s, no books, random first move and reply.
PY=$PWD/.venv-training/bin/python3
B=h2h/v214; [ -x $B/thoraxrex ] || B=h2h/v213
[ -x $B/thoraxrex ] && [ -x $PY ] || exit 1
D=data/pp
A=$D/sp2_train.csv,$D/sp3_train.csv,$D/sp4_train.csv,$D/sp5_train.csv,$D/sp6_train.csv,$D/sp7_train.csv,$D/sp8_train.csv,$D/sp9_train.csv,$D/sp10_train.csv,$D/sp11_train.csv
[ -s $D/sp12_train.csv ] && A=$A,$D/sp12_train.csv
EXTRA=294 CSVX=294 WD=0.02 $PY -u tools/train_qn.py 58 $A,val:$D/sp5_val.csv tools/net_q16.txt 96 48 0.5 8 > results/tq16.log 2>&1
[ -s tools/net_q16.txt ] || { echo "net_q16 missing"; exit 1; }
mkdir -p results/err
TAG=$(date +%m%d-%H%M)
unset TR_POLICY TR_CLIMB TR_NET
export TR_BOOK=none
PIDS=()
for s in 1 2 3 4; do
  ( TR_NET=$PWD/tools/net_q16.txt MATCH_RANDPLIES=2 MATCH_ERRDIR=results/err MATCH_THREADS=1 MATCH_OPPENV="TR_BOOK=none,TR_NET=$PWD/tools/net_q12.txt" MATCH_GAMES=results/games-q16-q12-$TAG-$s.txt \
    python3 -u tools/match.py $B/thoraxrex "$PWD/$B/thoraxrex" 50 1 Base+MLP $((s*101+220000)) > results/par-q16-q12-$TAG-$s.log 2>&1 ) &
  PIDS+=($!)
done
wait $PIDS
python3 tools/sumpar.py results "$TAG" | tee results/summary-$TAG.txt
exit 0
