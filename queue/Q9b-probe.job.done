# Probe: what ML tooling does the Mac have (torch/MPS, numpy, mlx, jax)?
{ sysctl -n machdep.cpu.brand_string hw.ncpu hw.memsize; which python3; python3 --version
  python3 -c "import torch; print('torch', torch.__version__, 'mps', torch.backends.mps.is_available())" 2>&1 | tail -1
  python3 -c "import numpy; print('numpy', numpy.__version__)" 2>&1 | tail -1
  python3 -c "import mlx.core as mx; print('mlx', mx.__version__)" 2>&1 | tail -1
  ls /opt/homebrew/bin/python3* /usr/local/bin/python3* 2>/dev/null
  for p in /opt/homebrew/bin/python3 /usr/local/bin/python3; do [ -x $p ] && $p -c "import torch;print('$p torch',torch.__version__)" 2>&1 | tail -1; done
  pip3 --version; timeout 60 python3 -m pip download --no-deps torch -d /tmp/tprobe 2>&1 | tail -1
} > results/ml-probe.txt 2>&1
exit 0
