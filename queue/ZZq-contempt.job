# Rating-based contempt (27 Nov). v221 = v220 + TR_CONTEMPT (the bot sets it per game from the rating gap:
# 25 between equal ratings, 1 less per 4 points the opponent is higher, -60..60; unset = 25 as before).
# No-harm checks against the installed engine (v220, default 25), 200 games at 1 s, 8 shards:
#   c-25 (as against a player 200 points stronger)   c60 (as against a player 140+ points weaker)
# Equal engines cannot show the rating effect; these only check that the settings do not weaken play.
# The user asked (27 Nov): if neither setting plays weaker (each >= 95/200), install v221 (backup of v220 kept).
# Must finish before 06:00 (skipped if started after 04:30).
export PATH="$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
[ "$(date +%H%M)" -ge 0430 ] && [ "$(date +%H%M)" -lt 1200 ] && exit 0
OLD=h2h/v220; NEW=h2h/v221
rm -f results/contempt-scores.txt 2>/dev/null; : > results/contempt-scores.txt
[ -x $OLD/thoraxrex ] && [ -s tools/policy_v4.txt ] || exit 1
cargo build --release > results/build-v221.log 2>&1 || { echo BUILD FAILED; exit 1; }
mkdir -p $NEW results/err && cp target/release/thoraxrex $NEW/ && cp $OLD/thoraxrex-net.txt $NEW/
unset TR_POLICY TR_CLIMB TR_NET TR_POLROOT TR_POLROOTCAP TR_POLD TR_POLK TR_POLMODE TR_HASHMB TR_MAXTHREADS TR_CONTEMPT
export TR_BOOK=none
P4=$PWD/tools/policy_v4.txt
for C in -25 60; do
  [ "$(date +%H%M)" -ge 0500 ] && [ "$(date +%H%M)" -lt 1200 ] && break
  TAG=$(date +%m%d-%H%M)
  PIDS=()
  for s in 1 2 3 4 5 6 7 8; do
    ( TR_CONTEMPT=$C TR_POLICY=$P4 MATCH_RANDPLIES=2 MATCH_ERRDIR=results/err MATCH_THREADS=1 MATCH_OPPENV="TR_BOOK=none,TR_POLICY=$P4" MATCH_GAMES=results/games-c$C-i220-$TAG-$s.txt \
      python3 -u tools/match.py $NEW/thoraxrex "$PWD/$OLD/thoraxrex" 25 1 Base+MLP $((s*443+480000)) > results/par-c$C-i220-$TAG-$s.log 2>&1 ) &
    PIDS+=($!)
  done
  wait "${PIDS[@]}"
  python3 tools/sumpar.py results "$TAG" | tee results/summary-$TAG.txt
  SC=$(grep -o "c$C-i220: [0-9.]*" results/summary-$TAG.txt | awk '{print $2}')
  echo "c$C ${SC:-none}" >> results/contempt-scores.txt
  sleep 61
done
# Install only when both checks ran and neither scored below 95/200.
OK=$(awk 'BEGIN{n=0;bad=0} {n++; if($2=="none"||$2+0<95)bad=1} END{print (n==2&&!bad)?"yes":"no"}' results/contempt-scores.txt 2>/dev/null)
echo "install: $OK" | tee -a results/contempt-scores.txt
if [ "$OK" = yes ]; then
  E=$HOME/Documents/Codex/FoulBroodData/Engines
  mkdir -p $E/backup-v220 && cp -p $E/ThoraxRex/thoraxrex $E/backup-v220/thoraxrex
  # a new file moved into place (copying over a running/checked executable in place makes macOS kill it at launch)
  for D in ThoraxRex ThoraxRex-NoBook; do cp $NEW/thoraxrex $E/$D/thoraxrex.new && chmod 755 $E/$D/thoraxrex.new && mv -f $E/$D/thoraxrex.new $E/$D/thoraxrex; done
  echo "installed v221" | tee -a results/contempt-scores.txt
fi
exit 0
