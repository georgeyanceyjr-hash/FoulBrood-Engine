# Queen danger: enemy piece on our queen and our covered pillbug guard count much more. qc84 / qc106 vs v2.6 (h2h/v26), and vs Foulbrood 4.1.
export PATH="$HOME/.cargo/bin:$PATH"
python3 -c "open('src/eval.rs','w').write(open('eval_qcov.rs').read())"
grep -q TR_QCOV src/eval.rs || { echo "eval.rs not updated"; exit 1; }
cargo build --release > results/build-qcov.log 2>&1 || { echo BUILD FAILED; exit 1; }
cp tools/net14.txt target/release/thoraxrex-net.txt
export VARIANTS="qc84 qc106" OPPS="../../ThoraxRex/h2h/v26/thoraxrex" SHARDS=5 GAMES=24 SO=41000 MATCH_RANDPLIES=2
./tools/par.command
export VARIANTS="pb qc84 qc106" OPPS="Foulbrood-4.1/wrapper.py" SHARDS=3 GAMES=12 SO=42000 MATCH_RANDPLIES=2
./tools/par.command
rm -f target/release/thoraxrex-net.txt
exit 0
