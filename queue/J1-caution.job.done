# Risk aversion (TR_CAUTION %): own-queen danger counts extra. ca50 / ca150 vs current v2.4 (pillbug terms), Black and White both.
export PATH="$HOME/.cargo/bin:$PATH"
mkdir -p h2h/pb
rm -f h2h/pb/thoraxrex; cp target/release/thoraxrex h2h/pb/thoraxrex
cp tools/net14.txt h2h/pb/thoraxrex-net.txt
python3 -c "open('src/eval.rs','w').write(open('eval_caut.rs').read())"
grep -q queen_danger src/eval.rs || { echo "eval.rs not updated"; exit 1; }
cargo build --release > results/build-caut.log 2>&1 || { echo BUILD FAILED; exit 1; }
cp tools/net14.txt target/release/thoraxrex-net.txt
export VARIANTS="ca50 ca150" OPPS="../../ThoraxRex/h2h/pb/thoraxrex" SHARDS=5 GAMES=24 SO=28000 MATCH_RANDPLIES=2
./tools/par.command
export VARIANTS="ca50 ca150" OPPS="Foulbrood-5.3/wrapper.py" SHARDS=2 GAMES=12 SO=29000 MATCH_RANDPLIES=2
./tools/par.command
rm -f target/release/thoraxrex-net.txt
exit 0
