# Cut the bonus for sitting on the enemy queen (TR_QONA; penalty for enemy on OUR queen stays 150).
# Both latest live losses started with a reckless climb onto the enemy queen. vs v2.7 and Foulbrood 4.1.
export PATH="$HOME/.cargo/bin:$PATH"
python3 -c "open('src/eval.rs','w').write(open('eval_qona.rs').read())"
grep -q TR_QONA src/eval.rs || { echo "eval.rs not updated"; exit 1; }
cargo build --release > results/build-qona.log 2>&1 || { echo BUILD FAILED; exit 1; }
cp tools/net14.txt target/release/thoraxrex-net.txt
export VARIANTS="qona0 qona50" OPPS="../../ThoraxRex/h2h/v27/thoraxrex" SHARDS=4 GAMES=30 SO=48000 MATCH_RANDPLIES=2
./tools/par.command
export VARIANTS="qona0 qona50" OPPS="Foulbrood-4.1/wrapper.py" SHARDS=3 GAMES=12 SO=49000 MATCH_RANDPLIES=2
./tools/par.command
rm -f target/release/thoraxrex-net.txt
exit 0
