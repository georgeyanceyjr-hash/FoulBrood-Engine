# Policy network in the search (move ordering + protection of its top moves). vs v2.8 and Foulbrood 4.1.
export PATH="$HOME/.cargo/bin:$PATH"
[ -s tools/policy_v1.txt ] || { echo "no policy weights" > results/s3-skip.txt; exit 0; }
python3 -c "
for n,f in [('policy','src_policy.rs'),('main','src_main.rs'),('datagen','src_datagen.rs'),('search','src_search_pol.rs'),('eval','src_eval_pol.rs')]: open(f'src/{n}.rs','w').write(open(f).read())"
cargo build --release > results/build-s3.log 2>&1 || { echo BUILD FAILED; exit 1; }
cp tools/net14.txt target/release/thoraxrex-net.txt
export VARIANTS="pol4 pol6 pol4k5" OPPS="../../ThoraxRex/h2h/v28/thoraxrex" SHARDS=4 GAMES=30 SO=66000 MATCH_RANDPLIES=2
./tools/par.command
export VARIANTS="pol4 pol6 pol4k5" OPPS="Foulbrood-4.1/wrapper.py" SHARDS=3 GAMES=12 SO=67000 MATCH_RANDPLIES=2
./tools/par.command
rm -f target/release/thoraxrex-net.txt
exit 0
