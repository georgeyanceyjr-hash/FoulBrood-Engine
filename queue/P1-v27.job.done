# v2.7 = v2.6 + covered pillbug guard 240 + enemy-on-queen 150 (flat). Install in the viewer.
export PATH="$HOME/.cargo/bin:$PATH"
python3 -c "open('src/eval.rs','w').write(open('eval_v27.rs').read())"
grep -q "50, 240\]" src/eval.rs || { echo "eval.rs not updated"; exit 1; }
sed -i '' 's/^version = "2\.[0-9]*\.[0-9]*"/version = "2.7.0"/' Cargo.toml
cargo build --release > results/build-v27.log 2>&1 || { echo BUILD FAILED; exit 1; }
E=$HOME/Documents/Codex/FoulBroodData/Engines
for d in ThoraxRex ThoraxRex-NoBook; do
  rm -f "$E/$d/thoraxrex"; cp target/release/thoraxrex "$E/$d/thoraxrex"
done
echo "exit" | "$E/ThoraxRex/thoraxrex" | head -1 > results/viewer27-install.txt
mkdir -p h2h/v27
rm -f h2h/v27/thoraxrex; cp target/release/thoraxrex h2h/v27/thoraxrex
cp tools/net14.txt h2h/v27/thoraxrex-net.txt
exit 0
