# Search change: don't prune/reduce moves that change how many pieces touch either queen (TR_QTAC, default on).
# A = new search + net14 ; B = previous build + net14.
export PATH="$HOME/.cargo/bin:$PATH"
mkdir -p h2h/base
rm -f h2h/base/thoraxrex; cp target/release/thoraxrex h2h/base/thoraxrex
cp tools/net14.txt h2h/base/thoraxrex-net.txt
python3 -c "open('src/search.rs','w').write(open('search_qtac.rs').read())"
grep -q TR_QTAC src/search.rs || { echo "search.rs not updated"; exit 1; }
cargo build --release > results/build-qtac.log 2>&1 || { echo BUILD FAILED; exit 1; }
cp tools/net14.txt target/release/thoraxrex-net.txt
export VARIANTS="qt" OPPS="../../ThoraxRex/h2h/base/thoraxrex" SHARDS=10 GAMES=12 SO=21000 MATCH_RANDPLIES=2
./tools/par.command
rm -f target/release/thoraxrex-net.txt
exit 0
