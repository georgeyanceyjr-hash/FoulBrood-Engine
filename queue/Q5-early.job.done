# Early lone raider penalty (TR_EARLY=w,hand): our ant/spider/grasshopper/ladybug touching the enemy queen while we still hold >= hand pieces. From the Antsy Dance archive (walking the first ant to the queen lost 3/3, developing won ~90%). vs v2.8 and 4.1.
export PATH="$HOME/.cargo/bin:$PATH"
python3 -c "open('src/eval.rs','w').write(open('eval_q5.rs').read()); open('src/search.rs','w').write(open('search_q5.rs').read())"
grep -q TR_EARLY src/eval.rs || { echo "eval.rs not updated"; exit 1; }
cargo build --release > results/build-q5.log 2>&1 || { echo BUILD FAILED; exit 1; }
cp tools/net14.txt target/release/thoraxrex-net.txt
export VARIANTS="e150 e250 e250h10" OPPS="../../ThoraxRex/h2h/v28/thoraxrex" SHARDS=4 GAMES=30 SO=54000 MATCH_RANDPLIES=2
./tools/par.command
export VARIANTS="e150 e250 e250h10" OPPS="Foulbrood-4.1/wrapper.py" SHARDS=3 GAMES=12 SO=55000 MATCH_RANDPLIES=2
./tools/par.command
rm -f target/release/thoraxrex-net.txt
exit 0
