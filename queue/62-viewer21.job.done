# Install ThoraxRex 2.1 (neural evaluation net6) in the viewer, with and without the opening book.
export PATH="$HOME/.cargo/bin:$PATH"
cargo build --release > results/build-viewer21.log 2>&1 || { echo BUILD FAILED; exit 1; }
E=$HOME/Documents/Codex/FoulBroodData/Engines
for d in ThoraxRex ThoraxRex-NoBook; do
  mkdir -p "$E/$d"
  cp target/release/thoraxrex "$E/$d/thoraxrex"
  cp tools/net_v21.txt "$E/$d/thoraxrex-net.txt"
done
cp thoraxrex-book.txt "$E/ThoraxRex/thoraxrex-book.txt"
echo "exit" | "$E/ThoraxRex/thoraxrex" | head -1 > results/viewer21-install.txt
echo "exit" | "$E/ThoraxRex-NoBook/thoraxrex" | head -1 >> results/viewer21-install.txt
cat results/viewer21-install.txt
exit 0
