# Next loop: self-play data generated WITH the queen-neighbourhood net q4 (sp9: 10 x 500 games, depth 5,
# half from hivegame start positions, half from random openings), then retrain on sp2..sp9 with extras.
# q7 = no weight decay, q8 = weight decay .02. Match q4 (reference), q7, q8 vs v2.8, 180 games each.
export PATH="$HOME/.cargo/bin:$PATH"
PY=$HOME/Documents/Codex/hotfrass/.venv-training/bin/python3
[ -s tools/net_q4.txt ] || exit 1
D=data/qn; G=results/datagen
T=$(date +%m%d-%H%M)
DP=()
for i in 1 2 3 4 5; do
  TR_BOOK=none TR_POLICY=none TR_NET=tools/net_q4.txt TR_STARTS=tools/hg_starts.jsonl ./target/release/thoraxrex datagen 500 5 $((i*130003+${T//-/})) $G/sp9-$T-$i.jsonl &
  DP+=($!)
done
for i in 6 7 8 9 10; do
  TR_BOOK=none TR_POLICY=none TR_NET=tools/net_q4.txt ./target/release/thoraxrex datagen 500 5 $((i*130003+${T//-/})) $G/sp9-$T-$i.jsonl &
  DP+=($!)
done
wait "${DP[@]}"
cat $G/sp9-$T-*.jsonl > $G/sp9_train.jsonl
echo "sp9: $(wc -l < $G/sp9_train.jsonl) games"
./target/release/thoraxrex dumpfeat $G/sp9_train.jsonl $D/sp9_train.csv extra
B=$D/sp2_train.csv,$D/sp3_train.csv,$D/sp4_train.csv,$D/sp5_train.csv,$D/sp6_train.csv,$D/sp7_train.csv,$D/sp8_train.csv,$D/sp9_train.csv
V=val:$D/sp5_val.csv
EXTRA=288 $PY -u tools/train_qn.py 58 $B,$V tools/net_q7.txt 64 32 0.5 8 > results/tq7.log 2>&1 &
EXTRA=288 WD=0.02 $PY -u tools/train_qn.py 58 $B,$V tools/net_q8.txt 64 32 0.5 8 > results/tq8.log 2>&1 &
wait
export TR_POLICY=none TR_BOOK=none
VARIANTS="q4 q7 q8" OPPS="../../ThoraxRex/h2h/v28/thoraxrex" SHARDS=3 GAMES=60 SECS=1 SO=113000 MATCH_RANDPLIES=2 ./tools/par.command
exit 0
